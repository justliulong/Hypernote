{
  "name": "hypernote",
  "productName": "Hypernote",
  "desktopName": "app.hypernote",
  "version": "1.0.0",
  "description": "Folder-based notes in HTML, with live preview and full JavaScript support",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "linux": "bash start.sh",
    "build": "electron-builder --linux",
    "build:linux": "electron-builder --linux",
    "build:linux:appimage": "electron-builder --linux AppImage",
    "build:linux:deb": "electron-builder --linux deb",
    "build:linux:pacman": "electron-builder --linux pacman",
    "build:linux:rpm": "electron-builder --linux rpm",
    "build:win": "electron-builder --win",
    "build:win:portable": "electron-builder --win portable",
    "build:mac": "electron-builder --mac",
    "pack": "electron-builder --dir"
  },
  "keywords": [
    "notes",
    "html",
    "markdown",
    "notebook",
    "editor",
    "electron",
    "live-preview",
    "笔记"
  ],
  "license": "MIT",
  "homepage": "https://github.com/justliulong/Hypernote",
  "repository": {
    "type": "git",
    "url": "https://github.com/justliulong/Hypernote.git"
  },
  "bugs": {
    "url": "https://github.com/justliulong/Hypernote/issues"
  },
  "author": {
    "name": "justliulong",
    "email": "justliulong@users.noreply.github.com"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "electron": "^39.0.0",
    "electron-builder": "^26.0.0"
  },
  "dependencies": {
    "monaco-editor": "^0.52.2"
  },
  "build": {
    "appId": "app.hypernote",
    "productName": "Hypernote",
    "artifactName": "${productName}-${version}-${arch}.${ext}",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "src/**/*",
      "node_modules/monaco-editor/min/**/*",
      "!**/*.md",
      "!**/.gitignore",
      "!**/.npmrc"
    ],
    "asar": true,
    "asarUnpack": [
      "node_modules/monaco-editor/**/*"
    ],
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "pacman",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Utility;TextEditor;",
      "executableName": "hypernote",
      "syncDesktopName": true,
      "icon": "build/icons",
      "synopsis": "Notes in HTML with live preview",
      "description": "Folder-based notes in HTML — write notes that can run code."
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Hypernote"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.productivity"
    },
    "fileAssociations": [
      {
        "ext": "html",
        "name": "HTML Note",
        "description": "HTML note",
        "role": "Editor"
      },
      {
        "ext": "htm",
        "name": "HTML Note",
        "description": "HTML note",
        "role": "Editor"
      }
    ]
  },
  "allowScripts": {
    "electron@39.8.10": true,
    "electron-winstaller@5.4.0": true
  }
}
